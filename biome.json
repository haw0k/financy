{
  "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!node_modules",
      "!.next",
      "!out",
      "!build",
      "!dist",
      "!.turbo",
      "!*.mjs",
      "!next-env.d.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "useEditorconfig": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100,
    "attributePosition": "auto",
    "bracketSpacing": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "useExhaustiveDependencies": "off"
      },
      "a11y": {
        "noLabelWithoutControl": "off",
        "noRedundantRoles": "off",
        "noSvgWithoutTitle": "off",
        "useFocusableInteractive": "off",
        "useSemanticElements": "off",
        "useAriaPropsForRole": "off"
      },
      "suspicious": {
        "noExplicitAny": "warn",
        "noArrayIndexKey": "off",
        "noThenProperty": "off",
        "useIterableCallbackReturn": "off",
        "noDocumentCookie": "off"
      },
      "style": {
        "useImportType": "off",
        "useExportType": "off",
        "useNodejsImportProtocol": "off",
        "noNonNullAssertion": "off"
      },
      "security": {
        "noDangerouslySetInnerHtml": "off"
      },
      "nursery": {
        "useSortedClasses": "off"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              { "source": "react*", "type": false },
              [
                { "source": "@/hooks/**", "type": false },
                { "source": "@/components/providers", "type": false }
              ],
              [":NODE:", ":BUN:", { "source": ":PACKAGE:", "type": false }],
              [{ "source": "@/lib/shadcn", "type": false }, "@/lib/shadcn/**"],
              { "source": "@/components/**", "type": false },
              [{ "source": "@/lib/**", "type": false }, "!@/lib/shadcn", "!@/lib/shadcn/**"],
              [{ "source": "@/config", "type": false }, { "source": "@/enums", "type": false }],
              { "source": "@/schemas", "type": false },
              [":ALIAS:", "!@/types", "!@/interfaces"],
              { "source": "@/messages", "type": false },
              { "source": "@/app/**", "type": false },
              [":PATH:", "**/*.css"],
              { "source": "react*", "type": true },
              [
                { "source": "@/hooks/**", "type": true },
                { "source": "@/components/providers", "type": true }
              ],
              [":NODE:", ":BUN:", { "source": ":PACKAGE:", "type": true }],
              [
                { "source": "@/lib/shadcn", "type": true },
                { "source": "@/lib/shadcn/**", "type": true }
              ],
              { "source": "@/components/**", "type": true },
              [
                { "source": "@/lib/**", "type": true },
                { "source": "!@/lib/shadcn", "type": true },
                { "source": "!@/lib/shadcn/**", "type": true }
              ],
              [{ "source": "@/config", "type": true }, { "source": "@/enums", "type": true }],
              { "source": "@/schemas", "type": true },
              [{ "source": "@/interfaces", "type": true }, { "source": "@/types", "type": true }],
              { "source": "@/messages", "type": true },
              { "source": "@/app/**", "type": true },
              [{ "source": ":PATH:", "type": true }]
            ]
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "semicolons": "always",
      "trailingCommas": "es5",
      "arrowParentheses": "always",
      "bracketSameLine": false
    },
    "linter": {
      "enabled": true
    }
  },
  "css": {
    "parser": {
      "cssModules": true,
      "tailwindDirectives": true
    }
  }
}
